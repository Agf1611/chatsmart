APP_NAME=MPWA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

WA_URL_SERVER=https://node.your-domain.example
WA_URL_SERVER_PUBLIC=https://node.your-domain.example
WA_URL_SERVER_INTERNAL=http://127.0.0.1:3100
# Leave blank on local dev; on hosting use a persistent Linux path, e.g. /home/USER/wa-sessions
WA_CREDENTIALS_PATH=
PORT_NODE=3100
BAILEYS_FETCH_LATEST=false
BAILEYS_VERSION=
APP_INSTALLED=false
AI_INTERNAL_TOKEN=
LICENSE_KEY=
BUYER_EMAIL=
TYPE_SERVER=other
GITHUB_UPDATER_REPO_URL=https://github.com/Agf1611/chatsmart.git
GITHUB_UPDATER_BRANCH=main
GITHUB_UPDATER_TOKEN=
GITHUB_UPDATER_MIRROR_PATH=chatsmart
GITHUB_UPDATER_EXCLUDE_PATHS=.env,storage/,bootstrap/cache/,vendor/,node_modules/,credentials/,public/storage/,database/database.sqlite

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whastapp
DB_USERNAME=whastapp_user
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PORT=3000
AUTH=replace-with-random-string
ORIGIN=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example,https://node.your-domain.example
WEBHOOK=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
